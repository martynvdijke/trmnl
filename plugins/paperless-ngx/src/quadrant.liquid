{% comment %}TRMNL fields: {{ url }} {{ api_token }}{% endcomment %}
<div class="layout layout--col layout--stretch gap">
  {% if error %}
    <div class="item">
      <span class="value value--small">{{ error }}</span>
    </div>
  {% else %}
    <div class="item">
      <span class="value value--medium">{{ inbox_count }}</span>
      <span class="label">Inbox · {{ total_documents }} total</span>
    </div>
    {% if recent.size > 0 %}
      <div class="item">
        <span class="value value--small">{{ recent[0].title }}</span>
        <span class="label">{{ recent[0].created }}</span>
      </div>
    {% endif %}
  {% endif %}
  <div class="title_bar">
    <span class="title">Paperless-ngx</span>
  </div>
</div>
