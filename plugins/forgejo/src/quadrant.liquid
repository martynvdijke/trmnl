{% comment %}TRMNL fields: {{ url }} {{ api_key }} {{ bio }}{% endcomment %}
<div class="layout layout--col layout--stretch gap">
  {% if error %}
    <div class="item">
      <span class="value value--small">{{ error }}</span>
    </div>
  {% else %}
    <div class="item">
      <span class="value value--medium">{{ open_prs }}</span>
      <span class="label">PRs · {{ open_issues }} issues</span>
    </div>
  {% endif %}
  <div class="title_bar">
    <span class="title">Forgejo</span>
  </div>
</div>
