<div class="layout layout--col gap--small">
  {% if error %}
    <div class="item">
      <div class="content">
        <span class="value value--small">{{ error }}</span>
      </div>
    </div>
  {% else %}
    <div class="grid grid--cols-2 portrait:grid--cols-1">
      <div class="item">
        <div class="content">
          <span class="value value--medium">{{ photos }}</span>
          <span class="label label--small">Photos</span>
        </div>
      </div>
      <div class="item">
        <div class="content">
          <span class="value value--medium">{{ videos }}</span>
          <span class="label label--small">Videos</span>
        </div>
      </div>
      <div class="item">
        <div class="content">
          <span class="value value--medium">{{ usage_human }}</span>
          <span class="label label--small">Storage</span>
        </div>
      </div>
      <div class="item">
        <div class="content">
          <span class="value value--medium">v{{ version_full }}</span>
          <span class="label label--small">Immich</span>
        </div>
      </div>
    </div>
  {% endif %}
  <div class="title_bar">
    <span class="title">Immich Stats</span>
  </div>
</div>
