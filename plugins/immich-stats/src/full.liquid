<div class="layout layout--col gap--small">
  {% if error %}
    <div class="item">
      <div class="content">
        <span class="value value--medium">{{ error }}</span>
      </div>
    </div>
  {% else %}
    <div class="grid grid--cols-2 portrait:grid--cols-1">
      <div class="item">
        <div class="content">
          <span class="value value--large">{{ photos }}</span>
          <span class="label label--small">Photos</span>
        </div>
      </div>
      <div class="item">
        <div class="content">
          <span class="value value--large">{{ videos }}</span>
          <span class="label label--small">Videos</span>
        </div>
      </div>
      <div class="item">
        <div class="content">
          <span class="value value--large">{{ usage_human }}</span>
          <span class="label label--small">Storage</span>
        </div>
      </div>
      <div class="item">
        <div class="content">
          <span class="value value--large">v{{ version_full }}</span>
          <span class="label label--small">Immich</span>
        </div>
      </div>
    </div>
    {% if usage_by_user.size > 1 %}
      <div class="hr"></div>
      <div class="item">
        <div class="content">
          <span class="label label--small">Storage by user</span>
          {% for user in usage_by_user limit: 3 %}
            <div class="flex flex--row flex--between w--full">
              <span class="value value--small">{{ user.user_name }}</span>
              <span class="value value--small">{{ user.usage_human }}</span>
            </div>
          {% endfor %}
          {% if usage_by_user.size > 3 %}
            <span class="label label--small">+ {{ usage_by_user.size | minus: 3 }} more users</span>
          {% endif %}
        </div>
      </div>
      {% if server.licensed %}<span class="label label--small">Licensed</span>{% endif %}
    {% elsif server.licensed %}
      <span class="label label--small">Licensed</span>
    {% endif %}
  {% endif %}
  <div class="title_bar">
    <span class="title">Immich Stats</span>
  </div>
</div>
