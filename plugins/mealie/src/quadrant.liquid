<div class="layout layout--col gap--small">
  {% if error %}
    <div class="item">
      <div class="content">
        <span class="value value--small">{{ error }}</span>
      </div>
    </div>
  {% else %}
    <div class="grid grid--cols-2">
      <div class="item">
        <div class="content">
          <span class="value value--small lg:value--medium">{{ name }}</span>
          {% if total_time %}<span class="label">{{ total_time }}</span>{% endif %}
          {% if servings %}<span class="label label--small">{{ servings }} servings</span>{% endif %}
        </div>
      </div>
      <div class="item">
        {% if image %}
          <img class="image image-cover image-dither rounded" src="{{ image }}" />
        {% elsif rating %}
          <div class="content">
            <span class="value value--small">★ {{ rating }}</span>
          </div>
        {% endif %}
      </div>
    </div>
  {% endif %}
  <div class="title_bar">
    <span class="title">Recipe</span>
  </div>
</div>
