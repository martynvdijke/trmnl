<div class="layout layout--col gap--small">
  {% if error %}
    <div class="item">
      <div class="content">
        <span class="value value--small">{{ error }}</span>
      </div>
    </div>
  {% else %}
    <div class="grid grid--cols-2">
      <div class="item">
        <div class="content">
          <span class="value value--medium">{{ name }}</span>
          {% if total_time %}<span class="label">{{ total_time }}</span>{% endif %}
          {% if servings %}<span class="label">{{ servings }} servings</span>{% endif %}
          {% if prep_time %}<span class="label label--small">Prep {{ prep_time }}</span>{% endif %}
        </div>
      </div>
      <div class="item">
        {% if image %}
          <img class="image image-cover image-dither rounded" src="{{ image }}" />
        {% elsif description %}
          <div class="content">
            <span class="label label--small">{{ description | truncate: 60 }}</span>
          </div>
        {% endif %}
      </div>
    </div>
    {% if ingredients.size > 0 %}
      <div class="item">
        <div class="content">
          <span class="label label--small">Ingredients</span>
          {% for ingredient in ingredients limit: 4 %}
            <span class="label">• {{ ingredient }}</span>
          {% endfor %}
          {% if ingredients.size > 4 %}
            <span class="label label--small">+ {{ ingredients.size | minus: 4 }} more</span>
          {% endif %}
        </div>
      </div>
    {% endif %}
  {% endif %}
  <div class="title_bar">
    <span class="title">Recipe of the Day</span>
  </div>
</div>
