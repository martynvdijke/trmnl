<div class="layout layout--col gap--small">
  {% if error %}
    <div class="item">
      <div class="content">
        <span class="value value--small">{{ error }}</span>
      </div>
    </div>
  {% else %}
    <div class="item">
      <div class="content">
        <span class="value value--medium">{{ name }}</span>
        {% if description %}<span class="label label--small">{{ description | truncate: 70 }}</span>{% endif %}
        <div class="meta">
          {% if total_time %}<span class="label">{{ total_time }}</span>{% endif %}
          {% if servings %}<span class="label">{{ servings }} servings</span>{% endif %}
          {% if rating %}<span class="label">★ {{ rating }}</span>{% endif %}
        </div>
      </div>
    </div>
    {% if ingredients.size > 0 %}
      <div class="item">
        <div class="content">
          <span class="label label--small">Ingredients</span>
          {% for ingredient in ingredients limit: 3 %}
            <span class="label">• {{ ingredient }}</span>
          {% endfor %}
          {% if ingredients.size > 3 %}
            <span class="label label--small">+ {{ ingredients.size | minus: 3 }} more</span>
          {% endif %}
        </div>
      </div>
    {% endif %}
  {% endif %}
  <div class="title_bar">
    <span class="title">Recipe of the Day</span>
  </div>
</div>
