<div class="layout layout--col layout--stretch gap">
  {% if error %}
    <div class="item">
      <span class="value value--small">{{ error }}</span>
    </div>
  {% else %}
    <div class="title_bar">
      <span class="title">BoardGameGeek · @{{ username }}</span>
    </div>

    <div class="item">
      <span class="label">Latest Plays</span>
    </div>
    {% for p in plays limit:5 %}
      <div class="item">
        <div class="columns">
          <div class="column" style="width: 64px">
            {% if p.image %}<img class="image image-cover image-dither rounded" src="{{ p.image }}" />{% endif %}
          </div>
          <div class="column w--full">
            <span class="value value--medium">{{ p.name }}</span>
            <div class="meta">
              <span class="label">{{ p.date }}</span>
              {% if p.year %}<span class="label">{{ p.year }}</span>{% endif %}
            </div>
          </div>
        </div>
      </div>
      {% unless forloop.last %}<div class="hr"></div>{% endunless %}
    {% endfor %}

    {% if featured %}
      <div class="hr"></div>
      <div class="item">
        <span class="label">From Your Collection ({{ owned_count }})</span>
      </div>
      <div class="item">
        <div class="columns">
          <div class="column" style="width: 64px">
            {% if featured.image %}<img class="image image-cover image-dither rounded" src="{{ featured.image }}" />{% endif %}
          </div>
          <div class="column w--full">
            <span class="value value--medium lg:value--large">{{ featured.name }}</span>
            <div class="meta">
              {% if featured.year %}<span class="label">{{ featured.year }}</span>{% endif %}
              {% if featured.rating %}<span class="label">★ {{ featured.rating }}</span>{% endif %}
            </div>
          </div>
        </div>
      </div>
    {% endif %}
  {% endif %}
</div>
