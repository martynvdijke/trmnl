{%- comment -%} Layout only — data prep + ag_* partials live in src/shared.liquid. {%- endcomment -%}
<div class="layout layout--col gap--space-between bg--gray-70 p--4">
  {%- if error != blank -%}
    {% render "ag_notice" with title: "Not connected", body: error %}
  {%- elsif has_data -%}
    {%- comment -%}
      No room for the chart on OG; X re-shows it. Deliberately NOT "grid hidden
      lg:grid": the framework re-emits .grid after .hidden, so a base grid class
      would win the cascade and unhide the chart everywhere.
    {%- endcomment -%}
    <div class="hidden lg:grid h--40 lg:grow lg:mb--2">
      {% render "ag_chart" with q_points: queries_series, b_points: blocked_series %}
    </div>

    <div class="grid grid--cols-2 portrait:grid--cols-1 lg:portrait:grid--cols-2 gap--small">
      {% render "ag_metric" with value: queries, label: "DNS Queries" %}
      {% render "ag_metric" with value: blocked, label: "Blocked" %}
      {% render "ag_metric" with value: blocked_pct, label: "Blocked", sub: "of all queries", value_suffix: "%" %}
      {% render "ag_metric" with value: top_blocked_domain, label: "Top blocked", value_class: "value--small lg:value--medium" %}
    </div>
  {%- else -%}
    {% render "ag_notice" with title: no_data_title, body: no_data_body %}
  {%- endif -%}
</div>

{% render "ag_title_bar" with trmnl: trmnl, top_domain: top_blocked_domain %}
