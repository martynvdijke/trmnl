{% comment %}TRMNL fields: {{ url }} {{ client_id }} {{ client_secret }} {{ username }} {{ password }}{% endcomment %}
{% if error %}
<div class="layout layout--col gap--small">
  <div class="item">
    <div class="content">
      <div class="value value--small">{{ error }}</div>
    </div>
  </div>
</div>
{% else %}
<div class="layout layout--col gap--small">
  <div class="item">
    <div class="content">
      <div class="value value--medium">{{ unread }}</div>
      <div class="label label--small">unread</div>
    </div>
  </div>
</div>
{% endif %}
