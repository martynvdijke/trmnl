<div class="layout layout--row layout--stretch gap">
  {% if error %}
    <div class="item">
      <span class="value value--medium">{{ error }}</span>
    </div>
  {% else %}
    <div class="item">
      <span class="value value--large">{{ down }}</span>
      <span class="label">down</span>
    </div>
    <div class="item">
      <span class="value value--medium">{{ up }}</span>
      <span class="label">up · {{ total }} total</span>
    </div>
    {% if down_monitors.size > 0 %}
      <div class="item">
        <span class="value value--small">{{ down_monitors[0].name }}</span>
        <span class="label">first down</span>
      </div>
    {% endif %}
  {% endif %}
  <div class="title_bar">
    <span class="title">Uptime Kuma</span>
  </div>
</div>
