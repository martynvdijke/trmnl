<div class="layout layout--row layout--stretch gap">
  {% if error %}
    <div class="item">
      <span class="value value--medium">{{ error }}</span>
    </div>
  {% elsif has_session == false %}
    <div class="item">
      <span class="value value--medium">Nothing playing</span>
    </div>
  {% else %}
    <div class="columns">
      <div class="column">
        {% if cover %}<img class="image image-cover image-dither rounded" src="{{ cover }}" />{% endif %}
      </div>
      <div class="column w--full">
        <span class="value value--medium lg:value--large">{{ title }}</span>
        {% if author %}<span class="label">{{ author }}</span>{% endif %}
        {% if duration > 0 %}
          <div class="bar grow">
            <div class="bar__fill" style="width: {{ progress }}%"></div>
          </div>
        {% endif %}
      </div>
    </div>
  {% endif %}
  <div class="title_bar">
    <span class="title">Currently Listening</span>
  </div>
</div>
