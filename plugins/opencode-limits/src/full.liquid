{%- comment -%} Layout only — data prep + lm_* partials live in src/shared.liquid. {%- endcomment -%}
<div class="layout layout--col gap--space-between bg--gray-70 p--4">
  {%- if error != blank -%}
    {% render "lm_notice" with title: "Not connected", body: error %}
  {%- elsif has_data -%}
    <div class="grid grid--cols-3 gap--small">
      {% render "lm_metric" with value: limits[0].percent, label: limits[0].label, sub: limits[0].resets_in, value_suffix: "%" %}
      {% render "lm_metric" with value: limits[1].percent, label: limits[1].label, sub: limits[1].resets_in, value_suffix: "%" %}
      {% render "lm_metric" with value: limits[2].percent, label: limits[2].label, sub: limits[2].resets_in, value_suffix: "%" %}
    </div>

    <div class="grid">
      <div class="item bg--white rounded--medium p--4">
        <div class="content">
          <span class="value value--large lg:value--xlarge">{{ worst_percent }}%</span>
          <span class="label">{{ worst_label }} allowance used{%- if worst_status == "LIMIT" %} · rate limited{% endif -%}</span>
          <span class="label">Resets {{ worst.resets_at }}</span>
        </div>
      </div>
    </div>
  {%- else -%}
    {% render "lm_notice" with title: "No data", body: "OpenCode Go returned no usage limits." %}
  {%- endif -%}
</div>

{% render "lm_title_bar" with trmnl: trmnl, all_ok_flag: all_ok, stamp: generated_at, tightest: worst_label, resets_in: worst_resets_in, tz: timezone %}
