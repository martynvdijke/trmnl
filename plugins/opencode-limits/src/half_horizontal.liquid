<div class="layout layout--col layout--stretch gap">
  {% if error %}
    <div class="item">
      <div class="content flex flex--col w--full">
        <span class="value value--medium">{{ error }}</span>
      </div>
    </div>
  {% else %}
    <div class="item">
      <div class="content flex flex--col w--full">
        <div class="flex flex--row flex--between flex--center-y gap w--full">
          <span class="value value--medium lg:value--large text--{{ worst_level }}">{{ worst_label }}</span>
          <span class="value value--large lg:value--large text--{{ worst_level }}">{{ worst_percent }}%</span>
        </div>
        <div class="w--full">
          <span class="label">{{ worst_status }} · resets in {{ worst_resets_in }}</span>
        </div>
      </div>
    </div>
    <div class="hr"></div>
    <div class="item">
      <div class="content flex flex--col w--full">
        {% for item in limits %}
          <div class="flex flex--row flex--between flex--center-y gap w--full">
            <span class="label text--{{ item.level }}">{{ item.label }}</span>
            <span class="label text--{{ item.level }}">{{ item.percent }}% · {{ item.status_label }}</span>
          </div>
        {% endfor %}
      </div>
    </div>
  {% endif %}
  <div class="title_bar">
    <span class="title">Go Limits · {{ generated_at }}</span>
  </div>
</div>
