<div class="layout layout--col layout--stretch gap">
  {% if error %}
    <div class="item">
      <div class="content flex flex--col w--full">
        <span class="value value--medium">{{ error }}</span>
      </div>
    </div>
  {% else %}
    {% for item in limits %}
      <div class="item">
        <div class="content flex flex--col w--full">
          <div class="flex flex--row flex--between flex--center-y gap w--full">
            <span class="value value--small lg:value--medium text--{{ item.level }}">{{ item.label }}</span>
            <span class="value value--small lg:value--medium text--{{ item.level }}">{{ item.percent }}%</span>
          </div>
          <div class="w--full">
            <span class="label">{{ item.status_label }} · resets {{ item.resets_at }}</span>
          </div>
        </div>
      </div>
      {% unless forloop.last %}<div class="hr"></div>{% endunless %}
    {% endfor %}
  {% endif %}
  <div class="title_bar">
    <span class="title">Go Limits · {{ timezone }}</span>
  </div>
</div>
