<script src="https://trmnl.com/js/highcharts/12.3.0/highcharts.js"></script>
{%- comment -%}
  Shared data prep — trmnlp automatically prepends this file (src/shared.liquid)
  to every view, so the variables and {% template %} partials below are
  available in all layouts.

  Source: the OpenCode server session list, aggregated by src/transform.py into
    totals   [Today, Last 7 days, Last 30 days, All time] — sessions/cost/tokens
    weekly   12 buckets of tokens+cost (oldest->newest, each with epoch `ts`)
    monthly  30 daily buckets of sessions/cost/tokens

  Style follows the Umami Stats reference: dark gray canvas, white cards,
  Highcharts splines drawn in the card's ink color.
{%- endcomment -%}
{%- assign has_data = false -%}
{%- if totals != blank and totals.size > 0 -%}{%- assign has_data = true -%}{%- endif -%}

{%- assign no_data_title = 'No sessions' -%}
{%- assign no_data_body = 'OpenCode returned no sessions yet. Start a session on your server and refresh.' -%}

{%- comment -%}
  Weekly chart points. transform.py emits epoch seconds per bucket; Highcharts
  wants milliseconds, hence the '000' suffix.
{%- endcomment -%}
{%- assign token_points = weekly -%}
{%- assign cost_points = weekly -%}

{%- comment -%}
  oc_metric — one white metric tile: big number + label + a secondary line.
  Params: value (number|string|nil), label, sub (string|nil, e.g. "$4.20 · 1.2M"),
  value_class (size classes, default value--large), sub_class (extra classes on
  the sub line, e.g. to hide it on cramped screens). Isolated scope.
{%- endcomment -%}
{% template oc_metric %}
<div class="item bg--white rounded--medium">
  <div class="content w--full">
    <div class="px--4 pt--4 w--full">
      <span class="value value--tnums {{ value_class }}" data-fit-value="true">
        {%- if value == blank -%}
          —
        {%- else -%}
          {{- value -}}
        {%- endif -%}
      </span>
    </div>
    <span class="label px--4">{{ label }}</span>
    <span class="label px--4 pb--4 {{ sub_class }}">
      {%- if sub == blank -%}
        —
      {%- else -%}
        {{- sub -}}
      {%- endif -%}
    </span>
  </div>
</div>
{% endtemplate %}

{%- comment -%}
  oc_chart — weekly splines with dated x ticks: Tokens solid on the left axis,
  Cost dotted on its own right axis (dollars and token counts differ by orders
  of magnitude, so a shared axis flattens one line). The chart fills its card,
  so each layout sizes it on the wrapping .grid.
  Params: token_points / cost_points (arrays with ts + value keys).
{%- endcomment -%}
{% template oc_chart %}
{% assign chart_id = 'oc-chart-' | append_random %}
<div class="item bg--white rounded--medium py--4 px--1">
  <div class="w--full h--full" id="{{ chart_id }}"></div>
</div>
<script type="text/javascript">
  (function () {
    var dual = true;
    var elId = "{{ chart_id }}";
    var build = function () {
      var el = document.getElementById(elId);
      var px = function (v) { return TRMNLPaint.px(v, { el: elId }); };
      var ink = getComputedStyle(el).color;
      var font = px(16) + "px";
      var labels = { style: { fontSize: font, color: ink } };
      var series = [];
      series.push({ name: "Tokens", dashStyle: "Solid", yAxis: 0, data: [{% for w in token_points %}[{{ w.ts | append: '000' }}, {{ w.tokens }}],{% endfor %}] });
      series.push({ name: "Cost", dashStyle: "ShortDot", yAxis: 1, data: [{% for w in cost_points %}[{{ w.ts | append: '000' }}, {{ w.cost }}],{% endfor %}] });
      var axisTitle = function (text, side) {
        return { text: text, align: "high", textAlign: side, rotation: 0, offset: 0, y: -px(12), reserveSpace: false, style: { fontSize: font, color: ink } };
      };
      var yAxis = { title: { text: null }, min: 0, allowDecimals: false, tickAmount: 4, labels: labels, gridLineWidth: px(1), gridLineColor: ink, gridLineDashStyle: "ShortDot" };
      return Highcharts.chart(elId, TRMNLCharts.merge(TRMNLCharts.options({ el: elId }), {
        chart: { type: "spline", animation: false, height: null, spacing: [px(32), px(4), px(8), 0] },
        legend: { enabled: false, align: "right", verticalAlign: "top", margin: px(4), padding: 0, symbolWidth: px(28), itemStyle: { fontSize: font, fontWeight: "400", color: ink } },
        xAxis: {
          type: "datetime", labels: labels, tickPixelInterval: px(110),
          lineWidth: px(1), lineColor: ink, tickWidth: 0,
          gridLineWidth: px(1), gridLineColor: ink, gridLineDashStyle: "Dot"
        },
        yAxis: [
          Highcharts.merge(yAxis, { title: axisTitle("— Tokens", "left") }),
          Highcharts.merge(yAxis, { gridLineWidth: 0, opposite: true, title: axisTitle("⋯ Cost", "right") })
        ],
        plotOptions: { spline: { color: ink, lineWidth: px(3) } },
        series: series
      }));
    };
    var tries = 0;
    (function whenReady() {
      if (window.Highcharts && window.TRMNLCharts) { TRMNLCharts.watch(elId, build); }
      else if (tries++ < 100) { setTimeout(whenReady, 50); }
    })();
  })();
</script>
{% endtemplate %}

{%- comment -%}
  oc_notice — full-width message tile for the error / no-data states.
  Params: title (string), body (string).
{%- endcomment -%}
{% template oc_notice %}
<div class="grid">
  <div class="item bg--white rounded--medium p--4">
    <div class="content">
      <span class="value value--large lg:value--xlarge">{{ title }}</span>
      <span class="label">{{ body }}</span>
    </div>
  </div>
</div>
{% endtemplate %}

{%- comment -%}
  oc_title_bar — shared footer. Params: trmnl (namespace), stamp (generated-at
  string) and tz (timezone name) — render scope is isolated, so values must be
  passed in explicitly.
{%- endcomment -%}
{% template oc_title_bar %}
<div class="title_bar bg--white">
  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <polyline points="4 17 10 11 4 5"></polyline><line x1="12" y1="19" x2="20" y2="19"></line>
  </svg>
  <span class="title">OpenCode Usage</span>
  <span class="instance">{{ stamp }} · {{ tz }}</span>
</div>
{% endtemplate %}
