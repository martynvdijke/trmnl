{%- comment -%} Layout only — data prep + oc_* partials live in src/shared.liquid. {%- endcomment -%}
<div class="layout layout--col gap--space-between bg--gray-70 p--4">
  {%- if error != blank -%}
    {% render "oc_notice" with title: "Not connected", body: error %}
  {%- elsif has_data -%}
    <div class="grid grid--cols-2 portrait:grid--cols-1 lg:portrait:grid--cols-2 gap--small">
      {% render "oc_metric" with value: totals[0].sessions, label: "Today", sub: totals[0].cost_display, value_class: "value--small lg:value--large", sub_class: "hidden lg:inline-flex" %}
      {% render "oc_metric" with value: totals[1].sessions, label: "Last 7 days", sub: totals[1].cost_display, value_class: "value--small lg:value--large", sub_class: "hidden lg:inline-flex" %}
      {% render "oc_metric" with value: totals[2].sessions, label: "Last 30 days", sub: totals[2].cost_display, value_class: "value--small lg:value--large", sub_class: "hidden lg:inline-flex" %}
      {% render "oc_metric" with value: totals[3].tokens_display, label: "All time tokens", sub: totals[3].cost_display, value_class: "value--small lg:value--large", sub_class: "hidden lg:inline-flex" %}
    </div>
  {%- else -%}
    {% render "oc_notice" with title: no_data_title, body: no_data_body %}
  {%- endif -%}
</div>

{% render "oc_title_bar" with trmnl: trmnl, stamp: generated_at, tz: timezone %}
