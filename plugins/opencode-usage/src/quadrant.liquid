<div class="layout layout--col layout--stretch gap">
  {% if error %}
    <div class="item">
      <div class="content flex flex--col w--full">
        <span class="value value--medium">{{ error }}</span>
      </div>
    </div>
  {% else %}
    <div class="item content flex flex--col w--full">
      <div class="flex flex--row flex--between flex--center-y gap w--full">
        <div class="flex flex--col">
          <span class="value value--medium lg:value--large">{{ totals[0].sessions }}</span>
          <span class="label">today</span>
        </div>
        <span class="label">{{ totals[0].cost_display }} · {{ timezone }}</span>
      </div>
      <div class="flex flex--row flex--between flex--center-y gap w--full">
        <div class="flex flex--col">
          <span class="value value--medium lg:value--large">{{ totals[1].sessions }}</span>
          <span class="label">7 days</span>
        </div>
        <span class="label">{{ totals[1].cost_display }}</span>
      </div>
      <div class="flex flex--row flex--between flex--center-y gap w--full">
        <div class="flex flex--col">
          <span class="value value--medium lg:value--large">{{ totals[2].sessions }}</span>
          <span class="label">30 days</span>
        </div>
        <span class="label">{{ totals[2].cost_display }}</span>
      </div>
      <div class="flex flex--row flex--between flex--center-y gap w--full">
        <div class="flex flex--col">
          <span class="value value--medium lg:value--large">{{ totals[3].sessions }}</span>
          <span class="label">all time</span>
        </div>
        <span class="label">{{ totals[3].cost_display }}</span>
      </div>
    </div>
    <div class="hr"></div>
    <div class="item">
      <span class="value value--small">Streams (all time)</span>
      <div class="w--full">
        <span class="label">input {{ streams.input_display }} · output {{ streams.output_display }}</span>
      </div>
      <div class="w--full">
        <span class="label">reasoning {{ streams.reasoning_display }} · cache read {{ streams.cache_read_display }}</span>
      </div>
      {% if models.size > 0 %}
        <div class="w--full">
          <span class="label">top: {{ models[0].name }} {{ models[0].cost_display }}</span>
        </div>
      {% endif %}
    </div>
  {% endif %}
  <div class="title_bar">
    <span class="title">OpenCode Usage · {{ generated_at }}</span>
  </div>
</div>
