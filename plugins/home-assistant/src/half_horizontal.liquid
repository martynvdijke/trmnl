{% comment %}TRMNL fields: {{ url }} {{ token }} {{ entities }}{% endcomment %}
<div class="layout layout--row layout--stretch gap">
  {% if error %}
    <div class="item">
      <span class="value value--medium">{{ error }}</span>
    </div>
  {% else %}
    {% if mode == "entities" %}
      {% for item in items limit: 3 %}
        <div class="item">
          <span class="value value--small">{{ item.name }}</span>
          <span class="label">{{ item.state }}{{ item.unit }}</span>
        </div>
      {% endfor %}
      {% if items.size == 0 %}
        <div class="item"><span class="label">No matching entities</span></div>
      {% endif %}
    {% else %}
      <div class="item">
        <span class="value value--large">{{ total }}</span>
        <span class="label">entities</span>
      </div>
      <div class="item">
        <span class="value value--medium">{{ lights_on }}</span>
        <span class="label">lights on</span>
      </div>
      <div class="item">
        <span class="value value--small">{{ counts.light }} light · {{ counts.sensor }} sensor</span>
        <span class="label">domains</span>
      </div>
    {% endif %}
  {% endif %}
  <div class="title_bar">
    <span class="title">Home Assistant</span>
  </div>
</div>
