{% if error %}
<div class="layout layout--col gap--small">
  <div class="item">
    <div class="content">
      <div class="value value--small">{{ error }}</div>
    </div>
  </div>
</div>
{% else %}
<div class="layout layout--col gap--small">
  <div class="title_bar">
    <div class="title">Booklore</div>
  </div>
  <div class="item">
    <div class="content">
      <div class="value value--large">{{ total_books }}</div>
      <div class="label label--small">books</div>
    </div>
  </div>
</div>
{% endif %}
