{% comment %}TRMNL fields: {{ url }} {{ api_key }}{% endcomment %}
{% if error %}
<div class="layout layout--col gap--small">
  <div class="item">
    <div class="content">
      <div class="meta">Booklore</div>
      <div class="value value--small">{{ error }}</div>
    </div>
  </div>
</div>
{% else %}
<div class="layout layout--col gap--small">
  <div class="title_bar">
    <div class="title">Booklore</div>
    <div class="meta">{{ total_books }} books</div>
  </div>
  {% if reading_count == 0 %}
  <div class="item">
    <div class="content">
      <div class="value value--small">Nothing currently being read</div>
    </div>
  </div>
  {% else %}
  <div class="item">
    <div class="content">
      {% for b in reading %}
      <div class="flex flex--col gap--small">
        <div class="flex flex--row flex--between flex--center-y">
          <div class="value value--small">{{ b.title }}</div>
          <div class="meta">{{ b.progress_pct }}%</div>
        </div>
        <div class="label label--small">{{ b.author }}</div>
        <div class="bar grow">
          <div class="bar__fill" style="width: {{ b.progress_pct }}%"></div>
        </div>
      </div>
      {% unless forloop.last %}<div class="hr"></div>{% endunless %}
      {% endfor %}
    </div>
  </div>
  {% endif %}
</div>
{% endif %}
