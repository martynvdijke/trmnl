<div class="layout layout--col layout--stretch gap">
  {% if error %}
    <div class="item">
      <span class="value value--medium">{{ error }}</span>
    </div>
  {% else %}
    <div class="item">
      <div class="flex flex--row flex--between w--full">
        <div class="flex flex--col">
          <span class="value value--large">{{ total }}</span>
          <span class="label">drives</span>
        </div>
        <div class="flex flex--col">
          <span class="value value--large">{{ failed_count }}</span>
          <span class="label">failed</span>
        </div>
        <div class="flex flex--col">
          <span class="value value--large">{{ warned_count }}</span>
          <span class="label">warned</span>
        </div>
      </div>
    </div>
    <div class="hr"></div>
    <div class="item">
      <span class="label label--small">Drives</span>
      {% for d in devices %}
        <div class="flex flex--row flex--between w--full">
          <span class="value value--small">{{ d.name }}</span>
          <span class="label">{{ d.status }}{% if d.temp %} · {{ d.temp }}°C{% endif %}</span>
        </div>
        {% unless forloop.last %}<div class="hr"></div>{% endunless %}
      {% endfor %}
    </div>
  {% endif %}
  <div class="title_bar">
    <span class="title">Scrutiny · Disk Health</span>
  </div>
</div>
