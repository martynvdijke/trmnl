<div class="layout layout--col layout--stretch gap">
  {% if error %}
    <div class="item">
      <span class="value value--medium">{{ error }}</span>
    </div>
  {% else %}
    <div class="item">
      <div class="flex flex--row flex--between w--full">
        <div class="flex flex--col">
          <span class="value value--large">{{ hours }}</span>
          <span class="label">hours watched</span>
        </div>
        <div class="flex flex--col">
          <span class="value value--large">{{ plays }}</span>
          <span class="label">plays</span>
        </div>
        <div class="flex flex--col">
          <span class="value value--large">{{ users }}</span>
          <span class="label">users</span>
        </div>
      </div>
    </div>
    <div class="hr"></div>
    <div class="item">
      <span class="label label--small">Top Shows</span>
      {% for s in top_shows %}
        <div class="flex flex--row flex--between w--full">
          <span class="value value--small">{{ s.name }}</span>
          <span class="label">{{ s.plays }} plays · {{ s.hours }}h</span>
        </div>
        {% unless forloop.last %}<div class="hr"></div>{% endunless %}
      {% endfor %}
    </div>
  {% endif %}
  <div class="title_bar">
    <span class="title">Jellystat · This Month</span>
  </div>
</div>
